# Copy to .env (never commit .env). Real keys go ONLY in .env or the host's secret manager.
FINN_LLM_API_KEY=
# Example for Groq (docs: console.groq.com/docs/openai):
FINN_LLM_BASE_URL=https://api.groq.com/openai/v1
FINN_LLM_MODEL=qwen/qwen3.8-27b
# Groq's model page says reasoning_effort "none" gives instruct mode (no thinking):
FINN_LLM_EXTRA_BODY={"reasoning_effort":"none"}
FINN_LLM_TIMEOUT_S=30
FINN_LLM_MAX_RETRIES=1
FINN_LLM_MAX_TOKENS=700
# Optional, for cost reporting (USD per 1M tokens, copy from the provider's pricing page):
# FINN_LLM_PRICE_IN_PER_M=0.80
# FINN_LLM_PRICE_OUT_PER_M=4.00
# Live-call budget (in-memory, resets on restart):
FINN_LIVE_MAX_PER_MIN=2
FINN_LIVE_MAX_PER_DAY=40
# Snapshot folder (cached demo answers + extracted text, committed to git):
FINN_SNAPSHOT_DIR=data/snapshot
# Optional frontend origin(s), comma separated:
# FINN_CORS_ORIGINS=https://your-frontend.example
# Protected host check. Leave OFF except while testing on the host:
# FINN_ENABLE_HOST_CHECK=1
# FINN_ADMIN_TOKEN=   (long random string; on Render it is generated for you)
# Generic research (any NSE ticker). All optional; these are the defaults:
# FINN_CACHE_DIR=/tmp/finn_cache
# FINN_ANALYZE_MAX_PER_HOUR=8
# FINN_ANALYZE_MAX_PER_DAY=20
# FINN_RESEARCH_MAX_BYTES=35000000
# FINN_RESEARCH_DOWNLOAD_S=75
# FINN_RESEARCH_EXTRACT_S=80
# FINN_RESEARCH_DEADLINE_S=270
# FINN_LLM_TPM=6500
# FINN_LLM_OTPM=1000   output tokens per minute (Groq named this limit in a 429); 0 turns the output budget off
